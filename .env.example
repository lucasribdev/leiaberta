# Public configuration, embedded by Vite in BOTH browser and SSR builds.
# Run `npx supabase status` locally and copy only the URL + publishable key
# (or legacy anon key). Never put a service_role/secret key in VITE_*.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_local_key
